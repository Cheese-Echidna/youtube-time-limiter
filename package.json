{
    "name": "yt-time-limiter",
    "version": "3.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm build:source && concurrently -k \"pnpm build:watch\" \"web-ext run --source-dir=.extension-build --artifacts-dir=build/web-ext-artifacts\"",
        "build": "pnpm build:source && dotenv -- web-ext sign --source-dir=.extension-build --artifacts-dir=build/signed-builds --channel=listed --amo-metadata=amo.json",
        "build_unlisted": "pnpm build:source && dotenv -- web-ext sign --source-dir=.extension-build --artifacts-dir=build/signed-builds --channel=unlisted --amo-metadata=amo.json",
        "lint": "pnpm typecheck && eslint --config src/eslint.config.js \"src/**/*.ts\" --max-warnings=0",
        "format": "prettier --write \"**/*.{ts,js,mjs,json,css,html,md}\"",
        "typecheck": "tsc --noEmit --project src/tsconfig.json",
        "build:source": "node scripts/build.mjs",
        "build:watch": "node scripts/build.mjs --watch"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/firefox-webext-browser": "^120.0.4",
        "concurrently": "^9.2.1",
        "dotenv-cli": "^11.0.0",
        "esbuild": "^0.27.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^9.1.0",
        "globals": "^16.5.0",
        "prettier": "^3.3.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.2",
        "web-ext": "^8.0.0"
    }
}
