{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["DOM", "ES2022"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "useUnknownInCatchVariables": true,
        "allowJs": false,
        "checkJs": false,
        "skipLibCheck": true,
        "types": ["firefox-webext-browser"]
    },
    "include": ["./**/*.ts"]
}
